<Window x:Class="CropBookGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CropBookGui"
        xmlns:viewModels="clr-namespace:CropBookGui.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="800">
  <Window.DataContext>
    <viewModels:MainViewModel/>
  </Window.DataContext>
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="24"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="24"/>
    </Style>
    <Style TargetType="StackPanel">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <UniformGrid Grid.Row="0" Columns="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="処理："/>
        <RadioButton Content="Kindle" IsChecked="{Binding IsKindle.Value}"/>
        <RadioButton Content="BookLive" IsChecked="{Binding IsBookLive.Value}"/>
        <RadioButton Content="PokeMaga" IsChecked="{Binding IsPokeMaga.Value}"/>
        <RadioButton Content="Capture" IsChecked="{Binding IsCapture.Value}"/>
        <RadioButton Content="ScanBody" IsChecked="{Binding IsScanBody.Value}"/>
      </StackPanel>
      
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="出力："/>
        <RadioButton Content="PNG" IsChecked="{Binding IsPng.Value}"/>
        <RadioButton Content="JPEG" IsChecked="{Binding IsJpeg.Value}"/>
      </StackPanel>
      
      <UniformGrid Rows="1">
        <CheckBox Content="複数ディレクトリ" IsChecked="{Binding IsMultiDir.Value}"/>
        <CheckBox Content="複数ファイルチェック" IsChecked="{Binding IsAllCheck.Value}"/>
      </UniformGrid>
      
      <TextBlock Text="入力ディレクトリ"/>
      <TextBox Text="{Binding InputDir.Value}"/>
      
      <TextBlock Text="出力ディレクトリ"/>
      <TextBox Text="{Binding OutputDir.Value}"/>
      
      <TextBlock Text="スレッド数"/>
      <TextBox Text="{Binding ThreadCount.Value}"/>
      
      <TextBlock Text="{Binding StatusText.Value}"/>
      
      
      <UniformGrid Rows="1">
        <Button Content="処理" Command="{Binding ProcCommand}"/>
        <Button Content="終了" Command="{Binding ExitCommand}"/>
      </UniformGrid>
    </UniformGrid>
  </Grid>
</Window>
