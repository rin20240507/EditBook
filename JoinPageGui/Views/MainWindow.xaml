<Window x:Class="JoinPageGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JoinPageGui"
        xmlns:views="clr-namespace:JoinPageGui.Views"
        xmlns:viewModels="clr-namespace:JoinPageGui.ViewModels"
        xmlns:baseViews="clr-namespace:WpfBase.Views;assembly=WpfBase"
        mc:Ignorable="d"
        baseViews:CloseWindowAttachedBehavior.Close="{Binding Close.Value}"
        Title="{Binding Title}" Height="600" Width="1200">
  <Window.DataContext>
    <viewModels:MainViewModel />
  </Window.DataContext>
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="TextBlockBase">
    </Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="TbConsole">
      <Setter Property="FontSize" Value="12"/> 
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Width" Value="100"/>
      <Setter Property="Height" Value="40"/>
    </Style>
    <Style TargetType="ColumnDefinition" x:Key="ColumnHeader">
      <Setter Property="Width" Value="100" />
    </Style>
    <Style TargetType="ColumnDefinition" x:Key="ColumnMiddle">
      <Setter Property="Width" Value="20" />
    </Style>
    <Style TargetType="Border">
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="3*"/>
      <RowDefinition/>
      <RowDefinition Height="400" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource ColumnHeader}"/>
        <ColumnDefinition Style="{StaticResource ColumnMiddle}"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      
      <TextBlock Grid.Row="0" Grid.Column="0" Text="入力フォルダ"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="："/>
      <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Input.Value}"/>
      
      <TextBlock Grid.Row="1" Grid.Column="0" Text="出力フォルダ"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="："/>
      <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Output.Value}"/>
      
      <TextBlock Grid.Row="2" Grid.Column="0" Text="高さ"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="："/>
      <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding HeightSize.Value}"/>
    </Grid>
    
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="実行" Command="{Binding ExecuteCommand}"
              />
      <Button Grid.Column="1" Content="閉じる" Command="{Binding CloseCommand}"/>
    </Grid>
    
    <!-- <ListBox Grid.Row="2" ItemsSource="{Binding ProcessList}"/> -->
    <Border Grid.Row="2">
      <TextBlock TextWrapping="Wrap" Style="{StaticResource TbConsole}"
                 Text="{Binding Message.Value}"
      />
    </Border>

  </Grid>
</Window>
